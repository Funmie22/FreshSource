# Supabase PostgreSQL connection string from Project Settings > Database.
# Prefer the transaction pooler URL for serverless deployments.
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres
AUTO_CREATE_TABLES=false
CORS_ORIGINS=https://freshsource.example
LOG_LEVEL=INFO

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_NUMBER=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=true

OLLAMA_ENABLED=false
OPENAI_MODEL=gpt-4o-mini
