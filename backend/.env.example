# Use the Supabase PostgreSQL connection string from Project Settings > Database.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
AUTO_CREATE_TABLES=false

# Twilio WhatsApp (optional for local mock mode)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_NUMBER=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=false

# Optional Meta WhatsApp Cloud API alternative
# WHATSAPP_ACCESS_TOKEN=your_access_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Optional protection for POST /inventory
# INVENTORY_API_KEY=change-me
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# OpenAI natural-language listing extraction
OPENAI_API_KEY=sk-your_api_key
OPENAI_MODEL=gpt-4o-mini

# Free local AI alternative (install Ollama and run: ollama pull llama3.2:3b)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
